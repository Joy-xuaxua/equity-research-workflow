{
  "version": 1,
  "_purpose": "指标登记清单：采集端「指标登记」块的合法 key、单位归一表与勾稽复算规则；scripts/collision_check.py 的行为定义。清单外指标不登记；冲突表照旧人工填报，机器以登记块为准。",
  "units": {
    "股":       {"dim": "shares", "factor": 1},
    "千股":     {"dim": "shares", "factor": 1000},
    "万股":     {"dim": "shares", "factor": 10000},
    "百万股":   {"dim": "shares", "factor": 1000000},
    "亿股":     {"dim": "shares", "factor": 100000000},
    "元":       {"dim": "currency", "factor": 1, "ccy": "CNY"},
    "千元":     {"dim": "currency", "factor": 1000, "ccy": "CNY"},
    "万元":     {"dim": "currency", "factor": 10000, "ccy": "CNY"},
    "百万元":   {"dim": "currency", "factor": 1000000, "ccy": "CNY"},
    "亿元":     {"dim": "currency", "factor": 100000000, "ccy": "CNY"},
    "万亿":     {"dim": "currency", "factor": 1000000000000, "ccy": "CNY"},
    "港元":     {"dim": "currency", "factor": 1, "ccy": "HKD"},
    "千港元":   {"dim": "currency", "factor": 1000, "ccy": "HKD"},
    "万港元":   {"dim": "currency", "factor": 10000, "ccy": "HKD"},
    "百万港元": {"dim": "currency", "factor": 1000000, "ccy": "HKD"},
    "亿港元":   {"dim": "currency", "factor": 100000000, "ccy": "HKD"},
    "美元":     {"dim": "currency", "factor": 1, "ccy": "USD"},
    "千美元":   {"dim": "currency", "factor": 1000, "ccy": "USD"},
    "万美元":   {"dim": "currency", "factor": 10000, "ccy": "USD"},
    "百万美元": {"dim": "currency", "factor": 1000000, "ccy": "USD"},
    "亿美元":   {"dim": "currency", "factor": 100000000, "ccy": "USD"},
    "倍":       {"dim": "ratio", "factor": 1},
    "%":        {"dim": "percent", "factor": 1},
    "人":       {"dim": "people", "factor": 1},
    "元/股":    {"dim": "per_share", "factor": 1, "ccy": "CNY"},
    "港元/股":  {"dim": "per_share", "factor": 1, "ccy": "HKD"},
    "美元/股":  {"dim": "per_share", "factor": 1, "ccy": "USD"}
  },
  "_unit_parse": "复合单位解析顺序：① 整串直接命中 units 键；② 剥离币种前缀（人民币/港元/美元）后余下部分命中 units 键则继承前缀 ccy 与该键 factor（如 千美元→USD×1000、万人民币→CNY×10000）。同 dim 同 ccy 才归一比较；同 dim 异 ccy → P2 CURRENCY_MISMATCH（汇率折算属对账员职责，非脚本职责）；解析失败 → P2 UNIT_UNKNOWN，该条不参与对撞与勾稽。",
  "crosschecks": [
    {
      "id": "market_cap_identity",
      "expr": "market_cap == price_close * shares_outstanding",
      "inputs": ["market_cap", "price_close", "shares_outstanding"],
      "rel_tol": 0.03,
      "severity": "P1",
      "note": "A/H 双重上市、ADR 比例、多重上市市值单列时本式不适用，登记时以 scope 区分"
    },
    {
      "id": "balance_sheet_identity",
      "expr": "total_assets == total_liabilities + total_equity",
      "inputs": ["total_assets", "total_liabilities", "total_equity"],
      "rel_tol": 0.01,
      "severity": "P1",
      "note": "同一期末时点"
    },
    {
      "id": "fcf_identity",
      "expr": "fcf == cfo - capex",
      "inputs": ["fcf", "cfo", "capex"],
      "rel_tol": 0.05,
      "severity": "P1",
      "note": "公司自定义 FCF 口径差异大，超差进报告由对账员判定"
    },
    {
      "id": "pe_identity",
      "expr": "pe_ttm == market_cap / net_income",
      "inputs": ["pe_ttm", "market_cap", "net_income"],
      "rel_tol": 0.25,
      "severity": "P2",
      "note": "TTM 与财年净利错配常见，仅作哨兵；净利为负或近零时跳过"
    },
    {
      "id": "revenue_segments_sum",
      "expr": "revenue == sum(revenue_segment)",
      "inputs": ["revenue", "revenue_segment"],
      "aggregation": "sum_scope",
      "rel_tol": 0.03,
      "severity": "P1",
      "note": "同期间按 scope 加总"
    },
    {
      "id": "eps_identity",
      "expr": "eps == net_income / shares_outstanding",
      "inputs": ["eps", "net_income", "shares_outstanding"],
      "rel_tol": 0.20,
      "severity": "P2",
      "note": "EPS 用加权平均股本，与期末股本有差，仅作哨兵"
    }
  ],
  "metrics": {
    "price_close":           {"name_zh": "收盘价", "unit": "元/股", "lines_by_mode": {"full": ["02-market"], "earnings": ["04-market"]}, "crosschecks": ["market_cap_identity"]},
    "market_cap":            {"name_zh": "总市值", "unit": "元", "lines_by_mode": {"full": ["02-market"], "earnings": ["04-market"]}, "crosschecks": ["market_cap_identity", "pe_identity"]},
    "shares_outstanding":    {"name_zh": "总股本", "unit": "股", "lines_by_mode": {"full": ["01-disclosure", "02-market"], "earnings": ["01-disclosure", "04-market"]}, "crosschecks": ["market_cap_identity", "eps_identity"]},
    "high_52w":              {"name_zh": "52周最高", "unit": "元/股", "lines_by_mode": {"full": ["02-market"], "earnings": ["04-market"]}},
    "pe_ttm":                {"name_zh": "市盈率TTM", "unit": "倍", "lines_by_mode": {"full": ["02-market"], "earnings": ["04-market"]}, "crosschecks": ["pe_identity"]},
    "ps_ttm":                {"name_zh": "市销率TTM", "unit": "倍", "lines_by_mode": {"full": ["02-market"], "earnings": ["04-market"]}},
    "revenue":               {"name_zh": "营业收入", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["revenue_segments_sum"]},
    "revenue_segment":       {"name_zh": "分部收入", "unit": "元", "repeatable": true, "scope_required": true, "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["revenue_segments_sum"]},
    "gross_profit":          {"name_zh": "毛利", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}},
    "operating_income":      {"name_zh": "经营利润", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}},
    "net_income":            {"name_zh": "净利润(年内亏损)", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["pe_identity", "eps_identity"]},
    "cfo":                   {"name_zh": "经营活动现金流净额", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["fcf_identity"]},
    "capex":                 {"name_zh": "资本开支", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["fcf_identity"]},
    "fcf":                   {"name_zh": "自由现金流", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["fcf_identity"]},
    "eps":                   {"name_zh": "每股收益", "unit": "元/股", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["eps_identity"]},
    "total_assets":          {"name_zh": "总资产", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["balance_sheet_identity"]},
    "total_liabilities":     {"name_zh": "总负债", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["balance_sheet_identity"]},
    "total_equity":          {"name_zh": "所有者权益", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}, "crosschecks": ["balance_sheet_identity"]},
    "receivables":           {"name_zh": "应收账款", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}},
    "deferred_revenue":      {"name_zh": "合同负债(递延收入)", "unit": "元", "lines_by_mode": {"full": ["01-disclosure"], "earnings": ["01-disclosure"]}},
    "employees":             {"name_zh": "员工数", "unit": "人", "lines_by_mode": {"full": ["01-disclosure", "03-consensus"], "earnings": ["01-disclosure"]}},
    "consensus_revenue_fwd": {"name_zh": "一致预期收入(下期)", "unit": "元", "value_format": "scalar_or_range", "lines_by_mode": {"full": ["03-consensus"], "earnings": ["02-consensus"]}},
    "consensus_eps_fwd":     {"name_zh": "一致预期EPS(下期)", "unit": "元/股", "value_format": "scalar_or_range", "lines_by_mode": {"full": ["03-consensus"], "earnings": ["02-consensus"]}},
    "guidance_revenue":      {"name_zh": "收入指引", "unit": "元", "value_format": "range", "lines_by_mode": {"full": ["03-consensus"], "earnings": ["01-disclosure", "02-consensus"]}},
    "price_first_day_close": {"name_zh": "财报后首个完整交易日收盘", "unit": "元/股", "lines_by_mode": {"full": [], "earnings": ["04-market"]}}
  },
  "_period_note": "period 规范形式：FY2025 / 2025H1 / FY2026Q1 / 最新（行情类）。脚本归一变体（财年2025、2025、1H2025 等）；无法归一 → P3 PERIOD_UNRECOGNIZED。",
  "_value_note": "value 字段允许千分位逗号与负数；区间值写 \"lo–hi\"（en/em dash 或 ~ 分隔），两个区间比较时重叠不立案；percent 值按原数值（不做 0.01 换算）。",
  "_anchor_note": "anchor＝登记条目所在采集文件内的原文片段（≥10 字符，建议整行表格行或完整短句），是对账回写打戳的定位点。唯一性口径：剔除「指标登记」块后的正文中出现且仅出现 1 次（登记块内的登记引用不计入）；≠1 → P2 ANCHOR_NOT_UNIQUE（merge 阶段升 P1）。"
}
